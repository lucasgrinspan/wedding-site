# Auto detect text files and perform LF normalization on checkout and commit
* text=auto

# Text file types
*.html text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.JPG binary
*.webp binary
*.ico binary
