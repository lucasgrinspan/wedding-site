{
  "name": "wedding-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "worker:types": "wrangler types -c worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "worker:typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4"
  }
}
