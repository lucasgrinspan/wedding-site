{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wedding-rsvp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
